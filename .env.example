# ---------------------------------------------------------------------------
# Garmin Data Viewer - copy to .env and edit.  .env is git-ignored.
# ---------------------------------------------------------------------------

# --- InfluxDB (stores all your Garmin metrics) -----------------------------
INFLUXDB_DB=GarminStats
INFLUXDB_USER=influxdb_user
# CHANGE THIS. Any non-empty string; you never type it by hand.
INFLUXDB_PASSWORD=change_me_influx

# --- Grafana (the dashboards) ----------------------------------------------
GRAFANA_USER=admin
# CHANGE THIS. This is what you log into the dashboard with.
GRAFANA_PASSWORD=change_me_grafana

# --- Garmin Connect ---------------------------------------------------------
# You are prompted for your Garmin email/password ONCE, interactively, on first
# run (see README "First run").  Only the resulting OAuth tokens are stored, in
# ./garminconnect-tokens.  Set this to True only if you use Garmin China.
GARMIN_IS_CN=False

# How often to check Garmin for new data, in seconds. 300 = 5 minutes.
UPDATE_INTERVAL_SECONDS=300

# Leave empty to auto-detect from your Garmin profile, or hardcode an IANA
# timezone such as Europe/Dublin.
USER_TIMEZONE=

# Which metric families to pull. The default covers everything a Venu 3 records.
FETCH_SELECTION=daily_avg,sleep,steps,heartrate,stress,breathing,hrv,vo2,activity,race_prediction,body_composition

LOG_LEVEL=INFO

# --- Ports (change if something already uses them) --------------------------
GRAFANA_PORT=3000
INFLUXDB_PORT=8086
OVERLAY_PORT=8787
